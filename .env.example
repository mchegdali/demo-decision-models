OPENAI_API_KEY=
TYPESAFE_AI_API_KEY=
# Required for web search. Start it with: pnpm searxng:up
SEARXNG_URL=http://localhost:8080
# Overrides server.secret_key in infra/searxng/settings.yml
SEARXNG_SECRET=
# Evaluator backend: typesafe (hosted Jev, needs TYPESAFE_AI_API_KEY) | ollama (Ollama library
# decision models: clef-flash, clef, nimble, tev1) | laya (self-hosted Laya) | local (any other
# self-hosted Jev-compatible /v1/systemone server, e.g. Kev).
# See docs/BENCHMARK_RESULTS.md to pick a model.
EVALUATOR_BACKEND=typesafe
# Used when EVALUATOR_BACKEND=ollama. Start it with: pnpm ollama:pull (once), then pnpm ollama:up.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Start Laya with: pnpm laya:up
LAYA_BASE_URL=http://localhost:8000/v1
# Optional: when set, laya-serve requires Authorization: Bearer <key>
LAYA_API_KEY=
# Optional: cap torch CPU threads inside the Laya container
LAYA_THREADS=
# Model id for EVALUATOR_BACKEND=ollama (default clef-flash:9b-q8_0) or local. Examples:
#   ollama: clef-flash:9b-q8_0 | clef:27b-q4_k_m | nimble:9b-q4_K_M | tev1:4b-q8_0 | tev1:0.8b-q8_0
#   local:  kev-latest (Kev, port from bench/containers.ps1)
EVALUATOR_MODEL_ID=
# Used when EVALUATOR_BACKEND=local, e.g. Kev: http://localhost:8020/v1
EVALUATOR_BASE_URL=
# Optional: sent as Authorization: Bearer <key> when the server requires one
EVALUATOR_API_KEY=
