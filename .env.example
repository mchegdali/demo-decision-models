OPENAI_API_KEY=
TYPESAFE_AI_API_KEY=
# Required for web search. Start it with: pnpm searxng:up
SEARXNG_URL=http://localhost:8080
# Overrides server.secret_key in infra/searxng/settings.yml
SEARXNG_SECRET=
# Evaluator backend: typesafe (hosted Jev, needs TYPESAFE_AI_API_KEY) | laya (self-hosted, CPU-only).
# Start Laya with: pnpm laya:up
EVALUATOR_BACKEND=typesafe
LAYA_BASE_URL=http://localhost:8000/v1
# Optional: when set, laya-serve requires Authorization: Bearer <key>
LAYA_API_KEY=
# Optional: cap torch CPU threads inside the Laya container
LAYA_THREADS=
