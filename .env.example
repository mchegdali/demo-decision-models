OPENAI_API_KEY=
TYPESAFE_AI_API_KEY=
# Required for web search. Start it with: pnpm searxng:up
SEARXNG_URL=http://localhost:8080
# Overrides server.secret_key in infra/searxng/settings.yml
SEARXNG_SECRET=
# Evaluator backend: typesafe (hosted Jev, needs TYPESAFE_AI_API_KEY) | laya (self-hosted Laya)
# | local (any self-hosted Jev-compatible /v1/systemone server: Clef, Kev, Nimble...).
# Start Laya with: pnpm laya:up. See docs/BENCHMARK_RESULTS.md to pick a model.
EVALUATOR_BACKEND=typesafe
LAYA_BASE_URL=http://localhost:8000/v1
# Optional: when set, laya-serve requires Authorization: Bearer <key>
LAYA_API_KEY=
# Optional: cap torch CPU threads inside the Laya container
LAYA_THREADS=
# Used when EVALUATOR_BACKEND=local. Examples (ports from bench/containers.ps1):
#   Clef-flash (pnpm clef:up): EVALUATOR_BASE_URL=http://localhost:8010/v1  EVALUATOR_MODEL_ID=clef-flash
#   Kev:                       EVALUATOR_BASE_URL=http://localhost:8020/v1  EVALUATOR_MODEL_ID=kev-latest
#   Nimble (Ollama):           EVALUATOR_BASE_URL=http://localhost:11434/v1 EVALUATOR_MODEL_ID=nimble:9b-q4_K_M
EVALUATOR_BASE_URL=
EVALUATOR_MODEL_ID=
# Optional: sent as Authorization: Bearer <key> when the server requires one
EVALUATOR_API_KEY=
